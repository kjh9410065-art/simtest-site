{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "simtest-test-stt",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "ai": {
    "binding": "AI"
  },
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
